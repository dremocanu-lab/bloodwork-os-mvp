# URL of the Bragi backend API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shows the "Ask Bragi" nav entry — leave false/unset until the backend's
# ASK_BRAGI_ENABLED is also on (see BRAGI_ASK_BRAGI_PLAN.md). This is a
# pure UI-visibility flag; the backend independently enforces its own
# flag and full authorization regardless of this setting.
NEXT_PUBLIC_ASK_BRAGI_ENABLED=false
