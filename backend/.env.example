# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/bragi

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret-at-least-32-chars

# Token lifetime in minutes (default: 1440 = 24 h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "development" to bypass SECRET_KEY strength check locally.
# Leave unset or set to "production" on deployed servers.
ENVIRONMENT=development

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ── Google Document AI ────────────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./google-docai-key.json
DOCAI_PROJECT_ID=your-gcp-project-id
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=your-processor-id

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# ── Document extraction provider (Bragi + Reducto, Phase 1) ───────────────────
# "legacy" (default) uses the built-in rule-based classifier + existing
# Google Document AI / OpenAI vision pipeline. Set to "reducto" only once
# REDUCTO_API_KEY is configured below AND the Reducto integration has been
# implemented and tested (see BRAGI_REDUCTO_PLAN.md) — until then this
# safely falls back to "legacy" even if set to "reducto".
DOCUMENT_EXTRACTION_PROVIDER=legacy
# Provider to use when the requested one above is unavailable.
DOCUMENT_EXTRACTION_FALLBACK=legacy

# Backend-only Reducto credential. NEVER expose this to the frontend
# (no NEXT_PUBLIC_ prefix, ever) — the frontend only ever talks to this
# FastAPI backend, which talks to Reducto.
REDUCTO_API_KEY=
# Master switch — must be "true" AND REDUCTO_API_KEY must be set for the
# Reducto provider to be used at all. Leave false until Reducto has been
# integrated and tested.
REDUCTO_ENABLED=false
