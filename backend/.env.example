# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/bragi

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret-at-least-32-chars

# Token lifetime in minutes (default: 1440 = 24 h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "development" to bypass SECRET_KEY strength check locally.
# Leave unset or set to "production" on deployed servers.
ENVIRONMENT=development

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ── Google Document AI ────────────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./google-docai-key.json
DOCAI_PROJECT_ID=your-gcp-project-id
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=your-processor-id

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000
